# Copy to .env.local and fill in. Validated by src/env.ts.
# Variables marked (Pn) become required in that phase.

# --- Public ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=          # (P7)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=       # (P5)
NEXT_PUBLIC_GA4_ID=                      # optional (D-15)

# --- Database: Neon Postgres (REQUIRED since P1) ---
DATABASE_URL=                            # pooled connection string (host contains -pooler)
DATABASE_URL_UNPOOLED=                   # direct connection string (migrations, seed)

# --- Seed: first SUPER_ADMIN (pnpm db:seed) ---
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=               # >= 12 chars; set once, change after first login
SEED_SUPER_ADMIN_NAME=

# --- Auth: Better Auth (REQUIRED since P2) ---
BETTER_AUTH_SECRET=                      # >= 32 chars, e.g. `openssl rand -base64 32`
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                    # redirect URI: <site>/api/auth/callback/google

# --- Cloudflare Turnstile (P7) ---
TURNSTILE_SECRET_KEY=

# --- Cloudinary (P5) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend email (P13) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Upstash Redis rate limiting (REQUIRED since P2) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- SMS: console = print OTP to the dev server log (refused in production) ---
SMS_PROVIDER=console
SMS_API_KEY=

# --- Telegram admin alerts (optional, P13) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CI only: skip env validation during typecheck/lint/build
# SKIP_ENV_VALIDATION=1
